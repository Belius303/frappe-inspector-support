      "id": "dynamic-sql-flow",
      "title": "Whitelisted input reaches dynamic SQL through a local helper",
      "source": "ERPNext #28512 / dynamic query regression coverage",
      "files": [
        { "path": "apps/sales/sales/hooks.py", "lines": ["app_name = 'sales'"] },
        { "path": "apps/sales/sales/modules.txt", "lines": ["Sales"] },
        { "path": "apps/sales/sales/api.py", "lines": [
          "import frappe",
          "@frappe.whitelist()",
          "def search(term):",
          "    return run_search(term)",
          "def run_search(value):",
          "    query = f'select name from tabCustomer where name = {value}'",
          "    return frappe.db.sql(query)"
        ] }
      ],
      "expectedFindings": [
        { "id": "dynamic-sql-taint", "ruleId": "FI040", "path": "apps/sales/sales/api.py", "severity": "error", "properties": { "entryPoint": "search", "sink": "frappe.db.sql" } }
      ]
    },
    {
