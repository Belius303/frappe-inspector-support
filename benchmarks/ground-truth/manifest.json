    {
      "id": "guarded-permission-bypass-negative",
      "title": "Explicit server permission guard suppresses permission-bypass finding",
      "source": "Negative control for server-side permission guards",
      "files": [
        { "path": "apps/sales/sales/hooks.py", "lines": ["app_name = 'sales'"] },
        { "path": "apps/sales/sales/modules.txt", "lines": ["Sales"] },
        { "path": "apps/sales/sales/api.py", "lines": [
          "import frappe",
          "@frappe.whitelist(allow_guest=True)",
          "def update_customer(name):",
          "    frappe.has_permission('Customer', 'write', throw=True)",
          "    doc = frappe.get_doc('Customer', name)",
          "    doc.save(ignore_permissions=True)"
        ] }
      ],
